{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "none" // ปิดโลโก้ด้านซ้ายออกเลย เพื่อความเป็น Minimal ขั้นสุด
  },
  "display": {
    "separator": "  ",
    "color": {
      "keys": "bright_blue" // กำหนดสีของข้อความฝั่งซ้าย
    }
  },
  "modules": [
    "title",
    "break",
    {
      "type": "os",
      "key": "os      "
    },
    {
      "type": "host",
      "key": "host    "
    },
    {
      "type": "kernel",
      "key": "kernel  "
    },
    {
      "type": "uptime",
      "key": "uptime  "
    },
    {
      "type": "shell",
      "key": "shell   "
    },
    {
      "type": "terminal",
      "key": "terminal"
    },
    {
      "type": "cpu",
      "key": "cpu     "
    },
    {
      "type": "memory",
      "key": "memory  "
    },
    "break",
    {
      "type": "colors",
      "symbol": "square" // หรือใช้ "circle" แสดงแถบสีแบบเรียบๆ
    }
  ]
}
