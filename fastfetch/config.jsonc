{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "none"
  },
  "display": {
    "separator": "  ",
    "color": {
      "keys": "bright_blue"
    }
  },
  "modules": [
    "title",
    "break",
    {
      "type": "os",
      "key": "os      "
    },
    {
      "type": "host",
      "key": "host    "
    },
    {
      "type": "kernel",
      "key": "kernel  "
    },
    {
      "type": "uptime",
      "key": "uptime  "
    },
    {
      "type": "shell",
      "key": "shell   "
    },
    {
      "type": "terminal",
      "key": "terminal"
    },
    {
      "type": "cpu",
      "key": "cpu     "
      },
      {
      "type": "gpu",
      "key": "gpu     "
    },
    {
      "type": "memory",
      "key": "memory  "
    },
    "break",
    {
      "type": "colors",
      "symbol": "square"
    }
  ]
}
