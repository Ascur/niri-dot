{
    "height": 24,
    "spacing": 4,
    "modules-left": ["niri/workspaces", "niri/window", "mpris"],
    "modules-center": [],
    "modules-right": ["group/expandable-tray", "network", "bluetooth", "wireplumber", "battery", "niri/language",  "custom/notification", "clock", "custom/power"],

    "niri/workspaces": {
        "disable-scroll": true,
        "all-outputs": true,
        "warp-on-scroll": false,
        "format": "{icon}"
    },

    "mpris": {
        "format": " {artist} - {title}",
        "format-paused": "PAUSED {artist} - {title}",
        "max-length": 30,
        "interval": 1,
        "tooltip": false
    },

"niri/language": {
        "format": "{}",
        "format-en": "US  |",
        "format-th": "TH  |"
    },

    "clock": {
        "interval": 1,
        "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt> |",
        "format": "{:%H:%M:%S}  |",
        "format-alt": "{:%Y-%m-%d}  |",
        "on-click-right": "gnome-calendar"
    },

    "backlight": {
        "format": "{icon} {percent}%",
        "format-icons": ["󰃞", "󰃟", "󰃠"]
    },

    "battery": {
    "format": "BAT {capacity}%  |",
    "format-charging": "PWR {capacity}%+"
},

    "bluetooth": {
        "format": "BT  |",
        "format-connected": "BT  |",
        "format-off": "BT OFF  |",
        "tooltip-format-connected": "{device_enumerate}",
        "tooltip-format-enumerate-connected": "{device_alias}",
        "on-click": "blueman-manager"
    },

    "network": {
        "format-wifi": "NET  |",
        "format-disconnected": "NET OFF  |",
        "tooltip-format-wifi": "{essid} {signalStrength}%",
        "on-click": "nm-connection-editor"
    },

    "wireplumber": {
        "format": "VOL {volume}%  |",
        "format-muted": "MUTE  |",
        "on-click": "pavucontrol"
    },


    "custom/power": {
        "format": "PWR  ",
        "on-click": "~/.config/niri/scripts/power-menu.sh",
        "tooltip": false
    },
    "group/expandable-tray": {
    "orientation": "horizontal",
    "drawer": {
        "transition-duration": 300,
        "transition-left-to-right": false
    },
    "modules": [
        "custom/tray-icon",
        "tray"
    ]
},


"custom/tray-icon": {
    "format": "󰅂",
    "tooltip": false
},


"tray": {
    "icon-size": 16,
    "spacing": 8
},

  "custom/notification": {
    "tooltip": true,
    "format": "{icon}",
    "format-icons": {
      "notification": "NOTIF*  |",
      "none": "NOTIF  |",
      "dnd-notification": "DND  |",
      "dnd-none": "DND  |",
      "inhibited-notification": "DND  |",
      "inhibited-none": "DND  |",
      "dnd-inhibited-notification": "DND  |",
      "dnd-inhibited-none": "DND  |"
    },
    "return-type": "json",
    "exec-if": "which swaync-client",
    "exec": "swaync-client -swb",
    "on-click": "swaync-client -t -sw",
    "on-click-right": "swaync-client -d -sw",
    "escape": true
  },
}
